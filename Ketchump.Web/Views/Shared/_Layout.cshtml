<!doctype html>

<html lang="en">

<head>
    <meta charset="utf-8">

    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">

    <title>
        @ViewData["Title"] - Ketchump
    </title>

    <link rel="icon" type="image/svg+xml" href="~/favicon.svg" asp-append-version="true">

    <!-- Google Fonts -->
    <link rel="preconnect"
          href="https://fonts.googleapis.com">

    <link rel="preconnect"
          href="https://fonts.gstatic.com"
          crossorigin>

    <link href="https://fonts.googleapis.com/css2?family=Nunito:wght@400;500;600;700;800;900&display=swap"
          rel="stylesheet">

    <!-- Site Styles -->
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true">
</head>

<body>

    <!-- Header -->
    <header class="topbar">

        <!-- Brand -->
        <a class="brand"
           href="/">
            <img src="~/favicon.svg" asp-append-version="true" width="28" height="28" alt="">
            <b>Ketchump</b>
        </a>

        <!-- Desktop Navigation -->
        <nav>
            <button data-page="pokedex">
                Pokédex
            </button>

            <button data-page="types">
                Types
            </button>

            <button data-page="trainers">
                Trainers
            </button>

            <button data-page="whos-that-pokemon">
                Who's That Pokémon?
            </button>

            <button data-page="favorites">
                My Pokémon

                <span class="fav-count"
                      data-fav-count>
                    0
                </span>
            </button>
        </nav>

        <!-- Theme Toggle -->
        <button id="themeToggle"
                class="icon-btn"
                aria-label="Toggle theme">
            ☾
        </button>

    </header>


    <!-- Page Content -->
    @RenderBody()


    <!-- Mobile Navigation -->
    <div class="mobile-nav">

        <button data-page="pokedex">
            <svg class="mobile-nav-icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
                <rect x="5" y="2" width="14" height="20" rx="2" />
                <circle cx="9" cy="6" r="1.5" />
                <path d="M13 5h1m2 0h.5M8 10h8v6H8zM8 19h3m4-1v2m-1-1h2" />
            </svg>
            <span>Pokédex</span>
        </button>

        <button data-page="types">
            <svg class="mobile-nav-icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
                <path d="m14 2-9 12h6l-1 8 9-12h-6z" />
            </svg>
            <span>Types</span>
        </button>

        <button data-page="trainers">
            <svg class="mobile-nav-icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
                <path d="M5 15v-3a7 7 0 0 1 14 0v3M3 15h16l3 3H3z" />
                <path d="m10 11 2-3 2 3" />
                <path d="M8 18v2h8v-2" />
            </svg>
            <span>Trainers</span>
        </button>

        <button data-page="whos-that-pokemon" aria-label="Who's That Pokémon?">
            <svg class="mobile-nav-icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
                <circle cx="12" cy="12" r="9" />
                <path d="M9.6 9a2.5 2.5 0 1 1 4.1 1.9c-1 .8-1.7 1.1-1.7 2.6M12 17h.01" />
            </svg>
            <span>Who's That?</span>
        </button>

        <button data-page="favorites">
            <svg class="mobile-nav-icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
                <circle cx="12" cy="12" r="9" />
                <path d="M3 12h4m10 0h4" />
                <path d="M12 16s-5-3-5-5a2.5 2.5 0 0 1 5-1 2.5 2.5 0 0 1 5 1c0 2-5 5-5 5Z" />
            </svg>
            <span>My Pokémon</span>

            <i data-fav-count>
                0
            </i>
        </button>

    </div>


    <!-- Footer -->
    <footer>
        Ketchump · Unofficial fan-made Pokémon encyclopedia · Data powered by PokéAPI
    </footer>


    <!-- Scripts -->
    <script src="~/js/app.js" asp-append-version="true"></script>

</body>

</html>
